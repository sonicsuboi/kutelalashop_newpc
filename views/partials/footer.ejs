    <section class="assist">
      <div>
        <h2>Liên hệ với tư vấn viên</h2>
        <dl class="assist-list">
          <dt>Email</dt>
          <dd><a href="mailto:<%= site.email %>"><%= site.email %></a></dd>
          <dt>Điện thoại</dt>
          <dd><a href="tel:<%= site.phone.replace(/\s/g, '') %>"><%= site.phone %></a></dd>
        </dl>
        <a class="more" href="/lien-he">Gửi tin nhắn</a>
      </div>
      <div>
        <h2>Tìm cửa hàng</h2>
        <p>Nhập tỉnh, thành phố để tìm cửa hàng <%= shopName %> gần nhất.</p>
        <form class="store-search" action="/cua-hang" method="get">
          <input type="search" name="q" placeholder="Tỉnh / thành phố" aria-label="Tỉnh hoặc thành phố">
          <button type="submit" aria-label="Tìm cửa hàng">
            <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M13 13l5.5 5.5" stroke="currentColor" stroke-width="1.4"/></svg>
          </button>
        </form>
      </div>
    </section>

    <div class="brand-strip"><a href="/"><%= shopName %></a></div>
  </main>

  <%# Chân trang nằm cố định phía dưới, phần <main> nền trắng trượt lên để lộ ra %>
  <footer class="site-footer">
    <div class="footer-cols">
      <div>
        <h2>Khám phá</h2>
        <ul>
          <li><a href="/san-pham">Sản phẩm mới</a></li>
          <% for (const [key, label] of Object.entries(categories)) { %>
            <li><a href="/san-pham?loai=<%= key %>"><%= label %></a></li>
          <% } %>
          <li><a href="/yeu-thich">Yêu thích</a></li>
          <li><a href="/gio-hang">Giỏ hàng</a></li>
        </ul>
      </div>
      <div>
        <h2>Cửa hàng</h2>
        <ul>
          <li><a href="/cua-hang">Hệ thống cửa hàng</a></li>
          <li><a href="/lien-he">Liên hệ</a></li>
          <li><a href="/tra-cuu-don">Tra cứu đơn hàng</a></li>
          <% if (site.zalo) { %><li><a href="<%= site.zalo %>" target="_blank" rel="noopener">Chat Zalo</a></li><% } %>
          <% if (site.facebook) { %><li><a href="<%= site.facebook %>" target="_blank" rel="noopener">Chat Messenger</a></li><% } %>
        </ul>
      </div>
      <div>
        <h2>Thương hiệu</h2>
        <ul>
          <li><a href="/">Trang chủ</a></li>
          <li><a href="/gioi-thieu">Giới thiệu</a></li>
        </ul>
      </div>
      <div>
        <h2>Hỗ trợ</h2>
        <ul>
          <% for (const [slug, page] of Object.entries(supportPages)) { %>
            <li><a href="/ho-tro/<%= slug %>"><%= page.title %></a></li>
          <% } %>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; <%= new Date().getFullYear() %> <%= shopName %></p>
      <a href="#top">Lên đầu trang</a>
    </div>
  </footer>

  <%# Hộp chọn nhanh màu và size, nội dung do main.js điền khi bấm "Thêm vào giỏ" trên thẻ sản phẩm %>
  <dialog class="quick" id="quick" aria-labelledby="quick-title">
    <form class="buy quick-form" action="/gio-hang/them" method="post">
      <button class="quick-close" type="button" data-quick-close aria-label="Đóng">✕</button>
      <div class="quick-media" data-quick-media></div>
      <div class="quick-info">
        <h2 id="quick-title" data-quick-name></h2>
        <p class="price" data-quick-price></p>
        <input type="hidden" name="product_id">
        <fieldset class="options" data-quick-colors><legend>Màu sắc: <b data-quick-color-name></b></legend></fieldset>
        <fieldset class="options" data-quick-sizes><legend>Size</legend></fieldset>
        <label class="qty"><span>Số lượng</span><input type="number" name="qty" value="1" min="1" max="10" inputmode="numeric"></label>
        <p class="stock-note" data-quick-note></p>
        <div class="detail-actions">
          <button class="btn btn-dark" type="submit">Thêm vào giỏ hàng</button>
          <a class="more" data-quick-link href="#">Xem chi tiết</a>
        </div>
      </div>
    </form>
  </dialog>

  <%# Nút chat nổi ở góc màn hình: bấm là mở Zalo / Messenger để nhắn cho shop. Chỉ hiện khi đã khai báo link ở trang quản trị. %>
  <% if (site.zalo || site.facebook) { %>
    <div class="chat-float">
      <% if (site.zalo) { %><a class="chat-zalo" href="<%= site.zalo %>" target="_blank" rel="noopener" aria-label="Nhắn tin cho shop qua Zalo">
          <svg width="56" height="56" viewBox="0 0 56 56" aria-hidden="true">
            <rect width="56" height="56" rx="16" fill="#0068ff"/>
            <path fill="#fff" d="M28 11c-10.500 0-19 7.200-19 16.100 0 4.900 2.600 9.300 6.700 12.200-.3 2.300-1.300 4.300-2.900 5.900 3.300-.2 6.200-1.300 8.500-3.100 2.100.7 4.300 1.100 6.700 1.100 10.500 0 19-7.200 19-16.100S38.500 11 28 11z"/>
            <text x="28" y="31.500" text-anchor="middle" font-family="Be Vietnam Pro, Arial, sans-serif" font-size="11" font-weight="800" fill="#0068ff">Zalo</text>
          </svg>
        </a><% } %>
      <% if (site.facebook) { %>
        <a class="chat-messenger" href="<%= site.facebook %>" target="_blank" rel="noopener" aria-label="Nhắn tin cho shop qua Messenger">
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2C6.4 2 2 6.1 2 11.4c0 3 1.500 5.600 3.800 7.300V22l3.400-1.900c.9.2 1.800.4 2.800.4 5.600 0 10-4.100 10-9.400S17.600 2 12 2zm1 12.600-2.600-2.700-5 2.700 5.500-5.800 2.600 2.700 4.900-2.700-5.400 5.800z"/></svg>
        </a>
      <% } %>
    </div>
  <% } %>

  <script src="/js/main.js"></script>
</body>
</html>

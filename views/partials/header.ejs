<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% const pageTitle = seo.title || `${title} | ${shopName}`; %>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= seo.description %>">
  <% if (seo.noindex) { %>
    <meta name="robots" content="noindex">
  <% } else { %>
    <link rel="canonical" href="<%= seo.canonical %>">
  <% } %>
  <meta property="og:type" content="<%= seo.jsonLd && seo.jsonLd['@type'] === 'Product' ? 'product' : 'website' %>">
  <meta property="og:site_name" content="<%= shopName %>">
  <meta property="og:locale" content="vi_VN">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= seo.description %>">
  <meta property="og:url" content="<%= seo.canonical %>">
  <meta property="og:image" content="<%= seo.image %>">
  <meta name="twitter:card" content="summary_large_image">
  <% if (site.google_verify && !site.google_verify.endsWith('.html')) { %><meta name="google-site-verification" content="<%= site.google_verify %>"><% } %>
  <% if (seo.jsonLd) { %><script type="application/ld+json"><%- JSON.stringify(seo.jsonLd).replace(/</g, '\\u003c') %></script><% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;700;800&display=swap">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body id="top">
  <header class="site-header">
    <button class="menu-btn" type="button" data-open-menu aria-controls="menu" aria-expanded="false">
      <svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true"><path d="M0 1h18M0 7h18M0 13h18" stroke="currentColor" stroke-width="1.4" fill="none"/></svg>
      <span>Menu</span>
    </button>

    <a class="logo" href="/"><%= shopName %></a>

    <div class="header-actions">
      <button class="icon-btn" type="button" data-toggle-search aria-controls="search" aria-expanded="false" aria-label="Tìm kiếm">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M13 13l5.5 5.5" stroke="currentColor" stroke-width="1.4"/></svg>
      </button>
      <a class="icon-btn" href="/yeu-thich" aria-label="Yêu thích">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1.8l2.5 5.3 5.7.7-4.2 4 1.1 5.7L10 14.7l-5.1 2.8L6 11.8l-4.2-4 5.7-.7z" stroke="currentColor" stroke-width="1.3" fill="none" stroke-linejoin="round"/></svg>
      </a>
      <%# Rê chuột (hoặc Tab) vào biểu tượng người thì xổ menu tài khoản; trên điện thoại bấm vào là tới trang tài khoản %>
      <div class="account-menu">
      <a class="icon-btn" href="<%= locals.customer ? '/tai-khoan' : '/tai-khoan/dang-nhap' %>" aria-label="<%= locals.customer ? 'Tài khoản' : 'Đăng nhập' %>" aria-haspopup="true">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="6.5" r="3.5" stroke="currentColor" stroke-width="1.3" fill="none"/><path d="M3 18c.6-3.6 3.4-5.5 7-5.5s6.4 1.900 7 5.500" stroke="currentColor" stroke-width="1.3" fill="none"/></svg>
      </a>
        <ul class="account-drop">
          <% if (locals.customer) { %>
            <li class="account-hello">Xin chào, <%= customer.name %></li>
            <li><a href="/tai-khoan">Tài khoản</a></li>
            <li><a href="/tai-khoan/don-hang">Đơn hàng</a></li>
            <li><a href="/yeu-thich">Yêu thích</a></li>
            <li><a href="/tai-khoan/mat-khau">Đổi mật khẩu</a></li>
            <li><form action="/tai-khoan/dang-xuat" method="post"><button type="submit">Đăng xuất</button></form></li>
          <% } else { %>
            <li><a href="/tai-khoan/dang-nhap">Đăng nhập</a></li>
            <li><a href="/tai-khoan/dang-ky">Đăng ký</a></li>
            <li><a href="/tra-cuu-don">Tra cứu đơn hàng</a></li>
            <li><a href="/yeu-thich">Yêu thích</a></li>
          <% } %>
        </ul>
      </div>
      <a class="icon-btn" href="/gio-hang" data-cart-icon aria-label="Giỏ hàng<%= cartCount ? ' (' + cartCount + ' sản phẩm)' : '' %>">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3.5 6.5h13l-1 11h-11zM7 6.5V5a3 3 0 0 1 6 0v1.5" stroke="currentColor" stroke-width="1.3" fill="none" stroke-linejoin="round"/></svg>
        <span class="cart-count" aria-hidden="true" data-cart-count <%= cartCount ? '' : 'hidden' %>><%= cartCount %></span>
      </a>
    </div>
  </header>

  <form class="search-bar" id="search" action="/san-pham" method="get" hidden>
    <input type="search" name="q" value="<%= current.q %>" placeholder="Tìm sản phẩm" aria-label="Tìm sản phẩm">
    <button type="submit">Tìm</button>
  </form>

  <nav class="menu" id="menu" hidden>
    <div class="menu-panel">
      <button class="menu-close" type="button" data-close-menu>Đóng</button>
      <ul>
        <li><a href="/">Trang chủ</a></li>
        <li><a href="/san-pham">Sản phẩm mới</a></li>
        <% for (const g of groups) { %>
          <li><a href="<%= g.href %>"><%= g.label %></a></li>
          <% if (g.categories.length > 1) { for (const c of g.categories) { %>
            <li class="sub"><a href="/san-pham?loai=<%= c.key %>"><%= c.label %></a></li>
          <% } } %>
        <% } %>
        <li><a href="/yeu-thich">Yêu thích</a></li>
        <li><a href="/gio-hang">Giỏ hàng</a></li>
        <li><a href="<%= locals.customer ? '/tai-khoan' : '/tai-khoan/dang-nhap' %>"><%= locals.customer ? 'Tài khoản' : 'Đăng nhập' %></a></li>
        <% if (locals.customer) { %>
          <li class="sub"><a href="/tai-khoan/don-hang">Đơn hàng</a></li>
          <li class="sub"><a href="/tai-khoan/mat-khau">Đổi mật khẩu</a></li>
        <% } else { %>
          <li class="sub"><a href="/tra-cuu-don">Tra cứu đơn hàng</a></li>
        <% } %>
        <li><a href="/gioi-thieu">Giới thiệu</a></li>
        <li><a href="/cua-hang">Hệ thống cửa hàng</a></li>
        <li><a href="/lien-he">Liên hệ</a></li>
      </ul>
    </div>
  </nav>

  <main>

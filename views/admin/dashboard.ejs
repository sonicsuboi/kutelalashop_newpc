<%- include('head') %>
<%
  const todoItems = [
    { n: todo.newOrders, text: 'đơn mới cần gọi xác nhận', href: '/admin/don-hang?status=new', urgent: true },
    { n: todo.messages, text: 'tin nhắn của khách chưa trả lời', href: '/admin/tin-nhan', urgent: true },
    { n: todo.shipping, text: 'đơn đang chuẩn bị / đang giao', href: '/admin/don-hang?status=shipping' },
    { n: todo.refund, text: 'đơn đã huỷ cần hoàn tiền cho khách', href: '/admin/don-hang?status=cancelled', urgent: true },
    { n: todo.soldOut, text: 'mẫu đã hết hàng', href: '/admin/san-pham' },
    { n: todo.noPhoto, text: 'mẫu chưa có ảnh', href: '/admin/san-pham' },
  ].filter((t) => t.n > 0);
%>

<div class="section-head">
  <h1>Xin chào 👋</h1>
  <div class="quick-links">
    <a class="btn" href="/admin/san-pham/moi">+ Thêm sản phẩm</a>
    <a class="btn btn-light" href="/admin/don-hang">Xem đơn hàng</a>
  </div>
</div>

<section class="todo">
  <h2>Việc cần làm</h2>
  <% if (todoItems.length) { %>
    <ul>
      <% for (const t of todoItems) { %>
        <li><a href="<%= t.href %>" class="<%= t.urgent ? 'urgent' : '' %>"><b><%= t.n %></b> <%= t.text %> <span aria-hidden="true">→</span></a></li>
      <% } %>
    </ul>
  <% } else { %>
    <p class="muted">Không có việc gì đang chờ. 🎉</p>
  <% } %>
</section>

<div class="stats">
  <div class="stat"><span>Hôm nay</span><b><%= formatPrice(stats.todayRevenue) %></b><small><%= stats.todayOrders %> đơn</small></div>
  <div class="stat"><span>Tháng này</span><b><%= formatPrice(stats.monthRevenue) %></b><small><%= stats.monthOrders %> đơn</small></div>
  <a class="stat" href="/admin/truy-cap"><span>Truy cập hôm nay</span><b><%= stats.todayVisitors %> người</b><small><%= stats.todayViews %> lượt xem</small></a>
  <a class="stat" href="/admin/san-pham"><span>Trong kho</span><b><%= stats.units %> đôi / cái</b><small><%= stats.products %> mẫu</small></a>
</div>

<section class="card">
  <h2>Doanh thu 7 ngày gần nhất</h2>
  <p class="muted small">Tính cả đơn chưa giao, không tính đơn đã huỷ. Rê chuột vào cột để xem số.</p>
  <div class="chart" role="img" aria-label="Biểu đồ doanh thu 7 ngày gần nhất">
    <% for (const d of week) { %>
      <div class="chart-col" tabindex="0">
        <div class="chart-track"><div class="chart-bar" style="height: <%= d.revenue ? Math.max(3, Math.round(d.revenue / weekMax * 100)) : 0 %>%"></div></div>
        <span class="chart-tip"><%= formatPrice(d.revenue) %> · <%= d.orders %> đơn</span>
        <span class="chart-label"><%= d.label %></span>
      </div>
    <% } %>
  </div>
  <table class="sr-only">
    <caption>Doanh thu theo ngày</caption>
    <tr><th>Ngày</th><th>Doanh thu</th><th>Số đơn</th></tr>
    <% for (const d of week) { %><tr><td><%= d.label %></td><td><%= formatPrice(d.revenue) %></td><td><%= d.orders %></td></tr><% } %>
  </table>
</section>

<div class="cols">
  <section>
    <div class="section-head"><h2>Đơn mới nhất</h2><a href="/admin/don-hang">Xem tất cả</a></div>
    <% if (recent.length) { %>
      <%- include('order-rows', { orders: recent }) %>
    <% } else { %>
      <p class="muted">Chưa có đơn hàng nào.</p>
    <% } %>
  </section>
  <aside>
    <section class="card">
      <h2>Sắp hết hàng</h2>
      <% if (lowStock.length) { %>
        <ul class="low">
          <% for (const p of lowStock) { %>
            <li><a href="/admin/san-pham/<%= p.id %>"><%= p.name %></a><b class="<%= p.stock_total ? '' : 'warn' %>"><%= p.stock_total ? `còn ${p.stock_total}` : 'hết' %></b></li>
          <% } %>
        </ul>
      <% } else { %>
        <p class="muted">Mẫu nào cũng còn trên 5.</p>
      <% } %>
    </section>
  </aside>
</div>

<%- include('foot') %>

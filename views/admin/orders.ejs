<%- include('head') %>
<%
  // Link giữ nguyên các bộ lọc đang chọn, chỉ đổi phần truyền vào
  const link = (change, path = '/admin/don-hang') => {
    const next = { status, tt: pay, q, huy: cancel, ...change };
    const qs = new URLSearchParams(Object.entries(next).filter(([, v]) => v));
    return path + (qs.toString() ? '?' + qs : '');
  };
%>

<div class="section-head">
  <h1><%= title %></h1>
  <div class="quick-links">
    <button class="btn btn-light" type="button" data-print-selected disabled>In bill đã chọn</button>
    <a class="btn btn-light" href="<%= link({}, '/admin/don-hang/xuat.csv') %>">Xuất Excel</a>
  </div>
</div>

<nav class="tabs">
  <a href="<%= link({ status: '' }) %>" class="<%= status ? '' : 'active' %>">Tất cả</a>
  <% for (const [key, label] of Object.entries(admin.statuses)) { %>
    <a href="<%= link({ status: key }) %>" class="<%= status === key ? 'active' : '' %>"><%= label %> (<%= counts[key] || 0 %>)</a>
  <% } %>
</nav>

<form class="inline" action="/admin/don-hang" method="get">
  <% if (status) { %><input type="hidden" name="status" value="<%= status %>"><% } %>
  <input type="search" name="q" value="<%= q %>" placeholder="Mã đơn, tên, số điện thoại, mã vận đơn" aria-label="Tìm đơn hàng">
  <select name="tt" aria-label="Thanh toán">
    <option value="">Mọi tình trạng thanh toán</option>
    <option value="unpaid" <%= pay === 'unpaid' ? 'selected' : '' %>>Chưa thanh toán</option>
    <option value="paid" <%= pay === 'paid' ? 'selected' : '' %>>Đã thanh toán</option>
  </select>
  <select name="huy" aria-label="Kiểu huỷ">
    <option value="">Huỷ / hoàn: tất cả</option>
    <option value="truoc" <%= cancel === 'truoc' ? 'selected' : '' %>>Huỷ trước khi giao</option>
    <option value="sau" <%= cancel === 'sau' ? 'selected' : '' %>>Huỷ sau khi giao (hoàn hàng)</option>
    <option value="cho-hoan" <%= cancel === 'cho-hoan' ? 'selected' : '' %>>Đang chờ nhận lại hàng</option>
    <option value="hoan-tien" <%= cancel === 'hoan-tien' ? 'selected' : '' %>>Cần hoàn tiền cho khách</option>
  </select>
  <button class="btn btn-light" type="submit">Lọc</button>
  <% if (q || pay || cancel) { %><a href="<%= link({ q: '', tt: '', huy: '' }) %>">Bỏ lọc</a><% } %>
</form>

<% if (orders.length) { %>
  <p class="muted small"><%= orders.length %> đơn · tổng <%= formatPrice(total) %> (không tính đơn đã huỷ)</p>
  <%- include('order-rows', { orders, actions: true }) %>
<% } else { %>
  <p class="muted">Không có đơn hàng nào khớp.</p>
<% } %>

<script>
  // Tick chọn nhiều đơn rồi in bill một lượt (mỗi đơn một trang)
  const boxes = [...document.querySelectorAll('[data-pick]')];
  const all = document.querySelector('[data-pick-all]');
  const btn = document.querySelector('[data-print-selected]');
  const picked = () => boxes.filter((b) => b.checked).map((b) => b.value);
  const refresh = () => {
    const n = picked().length;
    btn.disabled = !n;
    btn.textContent = n ? `In ${n} bill đã chọn` : 'In bill đã chọn';
  };
  boxes.forEach((b) => b.addEventListener('change', refresh));
  if (all) all.addEventListener('change', () => { boxes.forEach((b) => { b.checked = all.checked; }); refresh(); });
  btn.addEventListener('click', () => window.open('/admin/don-hang/in?ids=' + picked().join(','), '_blank'));
</script>

<%- include('foot') %>

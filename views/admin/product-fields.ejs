<%# Các ô chung của form thêm và sửa sản phẩm. v: giá trị đang có, errors: lỗi theo tên ô %>
<%
  const hasSize = v.has_size !== undefined ? v.has_size === '1' : Number(v.size_max) > 0;
%>
<label class="field">
  <span>Tên sản phẩm</span>
  <input type="text" name="name" value="<%= v.name || '' %>" maxlength="150" required>
  <% if (errors.name) { %><em><%= errors.name %></em><% } %>
</label>

<div class="row">
  <label class="field">
    <span>Giá sỉ (đồng)</span>
    <input type="number" name="cost" value="<%= v.cost === null || v.cost === undefined ? '' : v.cost %>" min="0" step="1000" placeholder="vd: 390000">
    <small>Có giá sỉ thì giá bán tự tính theo bảng cộng giá.</small>
    <% if (errors.cost) { %><em><%= errors.cost %></em><% } %>
  </label>
  <label class="field">
    <span>Giá bán (đồng)</span>
    <input type="number" name="price" value="<%= v.price || '' %>" min="0" step="1000">
    <small>Chỉ dùng khi để trống giá sỉ.</small>
    <% if (errors.price) { %><em><%= errors.price %></em><% } %>
  </label>
  <label class="field">
    <span>Nhãn</span>
    <input type="text" name="badge" value="<%= v.badge || '' %>" maxlength="30" placeholder="vd: Mới">
  </label>
</div>

<div class="row">
  <label class="check">
    <input type="checkbox" name="has_size" value="1" <%= hasSize ? 'checked' : '' %>>
    <span>Có size (bỏ chọn cho kính, túi)</span>
  </label>
  <label class="field small">
    <span>Size nhỏ nhất</span>
    <input type="number" name="size_min" value="<%= v.size_labels ? 35 : (Number(v.size_min) || 35) %>" min="30" max="46">
  </label>
  <label class="field small">
    <span>Size lớn nhất</span>
    <input type="number" name="size_max" value="<%= v.size_labels ? 39 : (Number(v.size_max) || 39) %>" min="30" max="46">
  </label>
</div>
<label class="field">
  <span>Size chữ (cho quần áo)</span>
  <input type="text" name="size_labels" value="<%= v.size_labels || '' %>" maxlength="120" placeholder="vd: M, L, XL, XXL, 3XL">
  <small>Điền vào thì sản phẩm dùng các size này thay cho size số ở trên. Cách nhau bằng dấu phẩy. Đừng đổi thứ tự hay xoá bớt sau khi đã nhập tồn kho, vì tồn kho ghi theo vị trí của từng size.</small>
</label>
<% if (errors.size) { %><p class="error"><%= errors.size %></p><% } %>

<label class="field">
  <span>Mã nhà cung cấp</span>
  <input type="text" name="supplier_code" value="<%= v.supplier_code || '' %>" maxlength="40" placeholder="vd: BDGĐ229">
  <small>Mã của bên bán sỉ, để đặt lại hàng. Chỉ hiện trong trang quản trị, khách không thấy; tìm trong Kho sản phẩm bằng mã này cũng được.</small>
</label>

<label class="field">
  <span>Mô tả</span>
  <textarea name="description" rows="3" maxlength="1000"><%= v.description || '' %></textarea>
</label>

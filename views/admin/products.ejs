<%- include('head') %>

<div class="section-head">
  <h1><%= title %></h1>
  <a class="btn" href="/admin/san-pham/moi">Thêm sản phẩm</a>
</div>

<% if (deleted) { %><p class="notice ok" role="status">Đã xoá sản phẩm.</p><% } %>

<form class="inline" action="/admin/san-pham" method="get">
  <div class="suggest-box">
    <input type="search" name="q" value="<%= q %>" placeholder="Gõ tên hoặc mã để tìm" aria-label="Tìm sản phẩm" autocomplete="off"
           role="combobox" aria-expanded="false" aria-controls="product-suggest" aria-autocomplete="list" data-filter>
    <ul class="suggest" id="product-suggest" role="listbox" hidden></ul>
  </div>
  <button class="btn btn-light" type="submit">Tìm</button>
</form>

<div class="scroll">
  <table class="table">
    <thead>
      <tr><th>Hình</th><th>Mã</th><th>Sản phẩm</th><th>Danh mục</th><th class="num">Giá sỉ</th><th class="num">Giá bán</th><th class="num">Số ảnh</th><th class="num">Còn</th><th class="num">Lượt xem</th><th class="num">Yêu thích</th><th class="num">Đánh giá</th></tr>
    </thead>
    <tbody>
      <% for (const p of products) { %>
        <tr data-row="<%= `${p.name} ${p.code || ''} ${p.supplier_code || ''}` %>" data-name="<%= p.name %>" data-code="<%= p.code || '' %>" data-href="/admin/san-pham/<%= p.id %>" data-img="<%= p.image_url || '' %>">
          <td class="thumb-cell"><a href="/admin/san-pham/<%= p.id %>" tabindex="-1" aria-hidden="true"><% if (p.image_url) { %><img class="thumb" src="<%= p.image_url %>" alt="" loading="lazy"><% } else { %><span class="thumb thumb-empty">Chưa có</span><% } %></a></td>
          <td><%= p.code || '—' %><% if (p.supplier_code) { %><br><span class="muted small">NCC: <%= p.supplier_code %></span><% } %></td>
          <td><a href="/admin/san-pham/<%= p.id %>"><b><%= p.name %></b></a><% if (p.hidden) { %> <span class="tag">Đang ẩn</span><% } %></td>
          <td><%= admin.categories[p.category] || p.category %></td>
          <td class="num"><%= p.cost === null ? '—' : formatPrice(p.cost) %></td>
          <td class="num"><%= formatPrice(p.price) %></td>
          <td class="num <%= p.media_count ? '' : 'warn' %>"><%= p.media_count %></td>
          <td class="num <%= p.stock_total ? '' : 'warn' %>"><%= p.stock_total || 'Hết' %></td>
          <td class="num"><%= p.view_count %></td>
          <td class="num"><%= p.fav_count %></td>
          <td class="num"><%= p.review_count %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<p class="muted" data-no-match <%= products.length ? 'hidden' : '' %>>Không tìm thấy sản phẩm nào.</p>

<script>
  // Gõ tới đâu lọc tới đó, không phân biệt dấu và chữ hoa: sản phẩm khớp là sản phẩm có đủ mọi từ đã gõ
  // (trong tên hoặc mã). Bảng bên dưới và danh sách gợi ý xổ xuống dùng chung một cách lọc.
  const fold = (s) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D').toLowerCase();
  const input = document.querySelector('[data-filter]');
  const list = document.getElementById('product-suggest');
  const rows = [...document.querySelectorAll('[data-row]')].map((el) => ({ el, text: fold(el.dataset.row) }));
  const noMatch = document.querySelector('[data-no-match]');
  const MAX_SUGGEST = 8;
  let active = -1;

  const close = () => {
    list.hidden = true;
    input.setAttribute('aria-expanded', 'false');
    active = -1;
  };
  const mark = () => {
    [...list.children].forEach((li, i) => li.setAttribute('aria-selected', String(i === active)));
    if (list.children[active]) list.children[active].scrollIntoView({ block: 'nearest' });
  };

  function apply(showList) {
    const words = fold(input.value).split(/\s+/).filter(Boolean);
    const matches = rows.filter((row) => words.every((w) => row.text.includes(w)));
    for (const row of rows) row.el.hidden = !matches.includes(row);
    noMatch.hidden = matches.length > 0;

    list.replaceChildren(...matches.slice(0, MAX_SUGGEST).map(({ el }) => {
      const li = document.createElement('li');
      li.setAttribute('role', 'option');
      li.dataset.href = el.dataset.href;
      const name = document.createElement('b');
      name.textContent = el.dataset.name;
      const code = document.createElement('span');
      code.textContent = el.dataset.code;
      // hình nhỏ đầu mỗi dòng gợi ý để nhận ra sản phẩm ngay
      const img = document.createElement(el.dataset.img ? 'img' : 'span');
      img.className = 'thumb';
      if (el.dataset.img) { img.src = el.dataset.img; img.alt = ''; }
      li.append(img, name, code);
      return li;
    }));
    active = -1;
    list.hidden = !(showList && words.length && matches.length);
    input.setAttribute('aria-expanded', String(!list.hidden));
  }

  input.addEventListener('input', () => apply(true));
  input.addEventListener('focus', () => apply(true));
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') return close();
    if (list.hidden || !list.children.length) return;
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      const n = list.children.length;
      active = (active + (e.key === 'ArrowDown' ? 1 : -1) + n) % n;
      mark();
    } else if (e.key === 'Enter' && active >= 0) {
      e.preventDefault();
      location.href = list.children[active].dataset.href;
    }
  });
  // mousedown thay vì click: phải chạy trước khi ô tìm mất focus và danh sách đóng lại
  list.addEventListener('mousedown', (e) => {
    const li = e.target.closest('li');
    if (li) { e.preventDefault(); location.href = li.dataset.href; }
  });
  input.addEventListener('blur', close);
</script>

<%- include('foot') %>

<%- include('head') %>

<h1><%= title %></h1>

<% if (saved) { %><p class="notice ok" role="status">Đã lưu.</p><% } %>

<form class="card wide" action="/admin/thong-tin" method="post">
  <h2>Liên hệ</h2>
  <p class="muted">Hiện ở chân trang và trang Liên hệ.</p>
  <label class="field">
    <span>Tên shop</span>
    <input type="text" name="name" value="<%= values.name || '' %>" maxlength="60" required>
    <% if (errors.name) { %><em><%= errors.name %></em><% } %>
  </label>
  <div class="row">
    <label class="field">
      <span>Email</span>
      <input type="email" name="email" value="<%= values.email || '' %>" maxlength="120" required>
      <% if (errors.email) { %><em><%= errors.email %></em><% } %>
    </label>
    <label class="field">
      <span>Điện thoại</span>
      <input type="text" name="phone" value="<%= values.phone || '' %>" maxlength="30" required>
      <% if (errors.phone) { %><em><%= errors.phone %></em><% } %>
    </label>
  </div>
  <div class="row">
    <label class="field">
      <span>Zalo của shop</span>
      <input type="text" name="zalo" value="<%= values.zalo || '' %>" maxlength="120" placeholder="Số điện thoại Zalo, vd: 0912345678">
      <small>Điền vào thì web hiện nút chat Zalo ở góc màn hình: khách bấm là mở Zalo nhắn cho số này. Để trống thì không hiện.</small>
      <% if (errors.zalo) { %><em><%= errors.zalo %></em><% } %>
    </label>
    <label class="field">
      <span>Messenger của shop</span>
      <input type="text" name="facebook" value="<%= values.facebook || '' %>" maxlength="200" placeholder="Tên trang Facebook, vd: kutelala.shop">
      <small>Tên trang trong link facebook.com/<b>tên-trang</b>. Để trống thì không hiện nút Messenger.</small>
      <% if (errors.facebook) { %><em><%= errors.facebook %></em><% } %>
    </label>
  </div>

  <h2>Hiển thị trên Google</h2>
  <label class="field">
    <span>Câu giới thiệu web</span>
    <textarea name="description" rows="2" maxlength="200" required><%= values.description || '' %></textarea>
    <small>Hiện dưới tên web trong kết quả tìm kiếm và khi chia sẻ link. Nên dài 120–160 ký tự, có những từ khách hay tìm (giày nữ, sandal, túi xách…).</small>
    <% if (errors.description) { %><em><%= errors.description %></em><% } %>
  </label>
  <label class="field">
    <span>Mã xác minh Google Search Console</span>
    <input type="text" name="google_verify" value="<%= values.google_verify || '' %>" maxlength="300" placeholder="Dán thẻ meta, hoặc tên file google….html Google đưa cho">
    <small>Cần để xem khách gõ từ khoá gì trên Google. Hướng dẫn ở trang <a href="/admin/seo">SEO</a>.</small>
    <% if (errors.google_verify) { %><em><%= errors.google_verify %></em><% } %>
  </label>
  <button class="btn" type="submit">Lưu thông tin</button>
</form>

<section class="card wide" id="cua-hang">
  <h2>Cửa hàng</h2>
  <p class="muted">Danh sách hiện ở trang Hệ thống cửa hàng. Tên, địa chỉ và tỉnh / thành phố là bắt buộc.</p>

  <% for (const s of stores) { %>
    <%- include('store-fields', { s, action: `/admin/thong-tin/cua-hang/${s.id}`, submit: 'Lưu' }) %>
  <% } %>
  <% if (!stores.length) { %><p class="muted">Chưa có cửa hàng nào.</p><% } %>

  <h2>Thêm cửa hàng</h2>
  <%- include('store-fields', { s: {}, action: '/admin/thong-tin/cua-hang', submit: 'Thêm cửa hàng' }) %>
</section>

<%- include('foot') %>

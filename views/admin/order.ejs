<%- include('head') %>

<p class="crumb"><a href="/admin/don-hang">Đơn hàng</a> / <%= admin.orderCode(order.id) %></p>
<h1>Đơn <%= admin.orderCode(order.id) %>
  <span class="tag st-<%= order.status %>"><%= admin.statuses[order.status] %></span>
  <span class="tag pay-<%= order.payment_status %>"><%= admin.payments[order.payment_status] %></span>
</h1>
<p><a class="btn btn-light" href="/admin/don-hang/<%= order.id %>/in" target="_blank" rel="noopener">In bill</a></p>
<% if (saved) { %><p class="notice ok" role="status">Đã lưu.</p><% } %>

<div class="cols">
  <section>
    <h2>Sản phẩm</h2>
    <table class="table">
      <thead><tr><th>Hình</th><th>Mã</th><th>Sản phẩm</th><th>Màu / size</th><th class="num">SL</th><th class="num">Đơn giá</th><th class="num">Thành tiền</th><th>Hoàn</th></tr></thead>
      <tbody>
        <% for (const item of items) { %>
          <tr class="<%= item.returned_qty >= item.qty ? 'returned' : '' %>">
            <td class="thumb-cell"><% if (item.image_url) { %><img class="thumb" src="<%= item.image_url %>" alt="" loading="lazy"><% } else { %><span class="thumb thumb-empty">Chưa có</span><% } %></td>
            <td><%= item.code || '—' %></td>
            <td><% if (item.slug) { %><a href="/admin/san-pham/<%= item.product_id %>"><%= item.name %></a><% } else { %><%= item.name %><% } %>
              <% if (item.returned_qty) { %><br><span class="tag tag-return">SP hoàn<%= item.returned_qty < item.qty ? ` ${item.returned_qty}/${item.qty}` : '' %></span><% if (item.return_note) { %> <span class="muted small"><%= item.return_note %></span><% } %><% if (!item.return_restocked) { %> <span class="muted small">(không cộng kho)</span><% } %><% } %></td>
            <td><%= [item.color, item.size && `Size ${item.size_label || item.size}`].filter(Boolean).join(' · ') || '—' %></td>
            <td class="num"><%= item.qty %></td>
            <td class="num"><%= formatPrice(item.price) %></td>
            <td class="num"><%= formatPrice(item.price * (item.qty - item.returned_qty)) %><% if (item.returned_qty) { %><br><s class="muted small"><%= formatPrice(item.price * item.qty) %></s><% } %></td>
            <td class="no-strike">
              <% if (order.status !== 'cancelled') { %>
                <details class="return-box">
                  <summary><%= item.returned_qty ? 'Sửa' : 'Hoàn SP' %></summary>
                  <form action="/admin/don-hang/<%= order.id %>/sp/<%= item.id %>/hoan" method="post">
                    <label class="field"><span>Số lượng hoàn</span>
                      <input type="number" name="qty" value="<%= item.returned_qty || item.qty %>" min="0" max="<%= item.qty %>"></label>
                    <label class="field"><span>Ghi chú</span>
                      <input type="text" name="note" value="<%= item.return_note || '' %>" maxlength="200" placeholder="vd: không vừa size"></label>
                    <label class="check"><input type="checkbox" name="restock" value="1" <%= !item.returned_qty || item.return_restocked ? 'checked' : '' %>><span>Cộng lại vào kho</span></label>
                    <button class="btn" type="submit">Lưu</button>
                    <small class="muted">Nhập 0 để bỏ đánh dấu hoàn.</small>
                  </form>
                </details>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
      <tfoot><% if (order.shipping_fee) { %><tr><td colspan="6">Phí vận chuyển</td><td class="num"><%= formatPrice(order.shipping_fee) %></td><td></td></tr><% } %><% if (order.returned_value) { %><tr><td colspan="6">Tổng ban đầu</td><td class="num"><s><%= formatPrice(order.total) %></s></td><td></td></tr><tr><td colspan="6">Sản phẩm hoàn</td><td class="num">−<%= formatPrice(order.returned_value) %></td><td></td></tr><% } %><tr><th colspan="6"><%= order.returned_value ? 'Tổng sau khi hoàn' : 'Tổng cộng' %></th><th class="num"><%= formatPrice(order.total - order.returned_value) %></th><th></th></tr></tfoot>
    </table>
  </section>

  <aside>
    <section class="card">
      <h2>Khách hàng</h2>
      <dl>
        <dt>Họ tên</dt><dd><%= order.name %></dd>
        <dt>Điện thoại</dt><dd><a href="tel:<%= order.phone.replace(/\s/g, '') %>"><%= order.phone %></a></dd>
        <dt>Địa chỉ</dt><dd><%= order.address %></dd>
        <% if (order.note) { %><dt>Ghi chú</dt><dd><%= order.note %></dd><% } %>
        <dt>Ngày đặt</dt><dd><%= admin.vnTime(order.created_at) %></dd>
        <dt>Tài khoản</dt><dd><%= order.customer_id ? 'Khách đã đăng nhập' : 'Khách vãng lai' %></dd>
        <% if (order.source) { %><dt>Đi từ kênh</dt><dd><%= admin.sourceLabel(order.source) %></dd><% } %>
      </dl>
    </section>

    <section class="card">
      <h2>Thanh toán</h2>
      <dl>
        <dt>Hình thức</dt><dd><%= admin.methods[order.payment_method] %></dd>
        <dt>Tình trạng</dt><dd><%= admin.payments[order.payment_status] %><% if (order.paid_at) { %> lúc <%= admin.vnTime(order.paid_at) %><% } %></dd>
        <% if (order.payment_ref) { %><dt>Mã giao dịch</dt><dd><%= order.payment_ref %></dd><% } %>
      </dl>
      <% const due = admin.refundDue(order); %>
      <% if (due) { %>
        <p class="error">Cần chuyển lại cho khách <b><%= formatPrice(due) %></b> (<%= order.status === 'cancelled' ? 'đơn đã huỷ sau khi thu tiền' : 'tiền sản phẩm hoàn' %>).</p>
        <form action="/admin/don-hang/<%= order.id %>/da-hoan-tien" method="post" onsubmit="return confirm('Xác nhận đã chuyển lại <%= formatPrice(due) %> cho khách?')">
          <button class="btn" type="submit">Đã hoàn tiền cho khách</button>
        </form>
      <% } %>
      <% if (order.refunded_amount) { %><p class="muted">Đã hoàn cho khách <%= formatPrice(order.refunded_amount) %> lúc <%= admin.vnTime(order.refunded_at) %>.</p><% } %>
      <% if (order.returned_value && order.payment_status !== 'paid' && order.status !== 'cancelled') { %>
        <p class="muted">Có sản phẩm hoàn: chỉ còn phải thu <b><%= formatPrice(order.total - order.returned_value) %></b>.</p>
      <% } %>
      <% if (order.payment_status !== 'paid' && order.status !== 'cancelled') { %>
        <form action="/admin/don-hang/<%= order.id %>/da-thanh-toan" method="post">
          <button class="btn btn-light" type="submit"><%= order.payment_method === 'bank' ? 'Đã nhận chuyển khoản' : 'Đánh dấu đã thu tiền' %></button>
        </form>
      <% } %>
    </section>

    <section class="card" id="giao-hang">
      <h2>Giao hàng</h2>
      <% if (order.status === 'cancelled') { %>
        <p class="muted">Đơn đã huỷ.</p>
      <% } else { %>
        <% if (order.shipped_at) { %><p class="muted">Đã giao cho bên vận chuyển lúc <%= admin.vnTime(order.shipped_at) %>.</p><% } %>
        <form action="/admin/don-hang/<%= order.id %>/giao-hang" method="post">
          <label class="field">
            <span>Đơn vị vận chuyển</span>
            <select name="carrier">
              <option value="">Chưa chọn</option>
              <% for (const [key, label] of Object.entries(admin.carriers)) { %>
                <option value="<%= key %>" <%= order.carrier === key ? 'selected' : '' %>><%= label %></option>
              <% } %>
            </select>
          </label>
          <label class="field">
            <span>Mã vận đơn</span>
            <input type="text" name="tracking_code" value="<%= order.tracking_code || '' %>" maxlength="60" placeholder="Mã bên vận chuyển cấp">
            <small>Khách thấy đơn vị vận chuyển và mã này khi xem đơn.</small>
          </label>
          <button class="btn" type="submit"><%= ['new', 'confirmed'].includes(order.status) ? 'Lưu và chuyển sang Đang giao' : 'Lưu' %></button>
        </form>
      <% } %>
    </section>

    <section class="card">
      <h2>Ghi chú của shop</h2>
      <form action="/admin/don-hang/<%= order.id %>/ghi-chu" method="post">
        <label class="field">
          <span class="sr-only">Ghi chú nội bộ</span>
          <textarea name="admin_note" rows="3" maxlength="1000" placeholder="Chỉ shop thấy, vd: khách hẹn giao sau 18h"><%= order.admin_note || '' %></textarea>
        </label>
        <button class="btn btn-light" type="submit">Lưu ghi chú</button>
      </form>
    </section>

    <section class="card">
      <h2>Xử lý đơn</h2>
      <% if (order.status === 'cancelled') { %>
        <p><b><%= admin.cancelLabel(order) %></b><% if (order.cancelled_at) { %> · huỷ lúc <%= admin.vnTime(order.cancelled_at) %><% } %></p>
        <% if (order.cancel_reason) { %><p class="muted">Lý do: <%= order.cancel_reason %></p><% } %>
        <% if (order.cancel_stage !== 'after') { %>
          <p class="muted">Hàng chưa rời shop nên đã được cộng lại vào kho.</p>
        <% } else if (order.returned_at) { %>
          <p class="muted">Đã nhận lại hàng lúc <%= admin.vnTime(order.returned_at) %>, hàng đã cộng vào kho.</p>
        <% } else { %>
          <p class="error">Hàng đang trên đường hoàn về, <b>chưa cộng vào kho</b>. Khi nhận lại và kiểm hàng xong thì bấm nút dưới.</p>
          <form action="/admin/don-hang/<%= order.id %>/nhan-hang-hoan" method="post" onsubmit="return confirm('Xác nhận đã nhận lại hàng và cộng vào kho?')">
            <button class="btn" type="submit">Đã nhận lại hàng, cộng vào kho</button>
          </form>
        <% } %>
      <% } else { %>
        <form class="inline" action="/admin/don-hang/<%= order.id %>/trang-thai" method="post">
          <select name="status" aria-label="Trạng thái đơn">
            <% for (const [key, label] of Object.entries(admin.statuses)) { if (key === 'cancelled') continue; %>
              <option value="<%= key %>" <%= order.status === key ? 'selected' : '' %>><%= label %></option>
            <% } %>
          </select>
          <button class="btn" type="submit">Cập nhật</button>
        </form>
        <% const stage = admin.cancelStageOf(order); %>
        <form action="/admin/don-hang/<%= order.id %>/huy" method="post"
              onsubmit="return confirm('<%= stage === 'after' ? 'Huỷ đơn đã giao cho vận chuyển? Hàng chỉ cộng lại kho khi bạn xác nhận đã nhận hàng hoàn.' : 'Huỷ đơn này và trả hàng về kho?' %>')">
          <h2><%= stage === 'after' ? 'Huỷ sau khi giao (hoàn hàng)' : 'Huỷ trước khi giao' %></h2>
          <label class="field">
            <span>Lý do</span>
            <select name="reason" required>
              <% for (const r of admin.cancelReasons[stage]) { %><option><%= r %></option><% } %>
            </select>
          </label>
          <label class="field">
            <span>Ghi thêm (không bắt buộc)</span>
            <input type="text" name="detail" maxlength="200">
          </label>
          <button class="btn btn-danger" type="submit"><%= stage === 'after' ? 'Huỷ đơn, chờ hàng hoàn về' : 'Huỷ đơn, trả hàng về kho' %></button>
        </form>
      <% } %>
    </section>
  </aside>
</div>

<%- include('foot') %>

<%- include('partials/header') %>

<%
  // Chiếc giày cao gót đứng vào chỗ chữ L đầu tiên của tên shop (gót giày là nét dọc của chữ L)
  const cut = shopName.indexOf('L');
%>
<section class="hero" style="--hero-img: url('<%= heroImage %>')">
  <div class="hero-copy">
    <p class="eyebrow">Bộ sưu tập mới</p>
    <p class="hero-word" role="img" aria-label="<%= shopName %>">
      <% if (cut === -1) { %><%= shopName %><% } else { %><span><%= shopName.slice(0, cut) %></span><svg viewBox="0 0 150 100" aria-hidden="true"><path fill="var(--accent)" d="M3 20h25l-5 80H10z"/><path fill="currentColor" d="M0 0C10 30 44 56 80 62C104 56 134 70 150 90C150 97 146 100 138 100H92C66 98 44 84 30 60L0 30Z"/></svg><span><%= shopName.slice(cut + 1) %></span><% } %>
    </p>
    <h1>Bước khác đi.</h1>
    <p>Giày dép nữ dáng cổ điển, đường nét tối giản, thêm một chút bất ngờ.</p>
    <a class="btn" href="/san-pham">Xem bộ sưu tập</a>
  </div>
</section>

<%# Dải chữ chạy: nội dung lặp 2 lần để chạy liền mạch, lần thứ hai ẩn với trình đọc màn hình %>
<nav class="marquee" aria-label="Danh mục nhanh">
  <div class="marquee-track">
    <% for (let i = 0; i < 2; i++) { const copy = i === 1 ? ' aria-hidden="true" tabindex="-1"' : ''; %>
      <% for (const g of groups) { %>
        <a href="<%= g.href %>"<%- copy %>><%= g.label %></a><span aria-hidden="true">✦</span>
      <% } %>
      <a href="/san-pham"<%- copy %>>Sản phẩm mới</a><span aria-hidden="true">✦</span>
      <a href="/gioi-thieu"<%- copy %>><%= shopName %></a><span aria-hidden="true">✦</span>
    <% } %>
  </div>
</nav>

<section>
  <div class="section-head">
    <h2>Sản phẩm nổi bật</h2>
    <a class="more" href="/san-pham">Xem tất cả</a>
  </div>
  <%# Mỗi danh mục một mẫu, xếp kiểu khảm: mẫu thứ 1 và thứ 6 là ô lớn (2 cột x 2 hàng), xen hai ô chữ
      để lưới không đều tăm tắp. Nhãn trên ảnh là tên danh mục. %>
  <ul class="grid grid-feature grid-mosaic">
    <% featured.forEach((product, i) => { %>
      <% if (i === 0) { %>
        <%# Ô lớn đầu tiên là khung trình chiếu: mỗi dòng hàng một mẫu (khác mẫu ở các ô bên cạnh để không trùng), trang cuối là liên hệ %>
        <li class="feature-show" data-slideshow>
          <% showcase.forEach((p, n) => { %>
            <a class="show-slide<%= n === 0 ? ' active' : '' %>" data-slide href="/san-pham/<%= p.slug %>"<% if (p.image_url) { %> style="background-image: url('<%= p.image_url %>')"<% } %>>
              <span class="eyebrow"><%= categories[p.category] %></span>
              <b><%= p.name %></b>
              <span class="show-price"><%= formatPrice(p.price) %></span>
              <span class="btn">Xem chi tiết</span>
            </a>
          <% }) %>
          <% const callNumber = site.phone.replace(/[^\d+]/g, ''); %>
          <div class="show-slide show-contact" data-slide style="background-image: url('/images/mosaic-1.jpg')">
            <span class="eyebrow">Liên hệ</span>
            <b>Hỏi shop trước khi mua</b>
            <span class="show-price">Tư vấn size, xem thêm ảnh thật, chốt đơn nhanh.</span>
            <span class="show-actions">
              <% if (site.zalo) { %><a class="btn" href="<%= site.zalo %>" target="_blank" rel="noopener">Nhắn Zalo</a><% } %>
              <% if (callNumber) { %><a class="btn btn-ghost" href="tel:<%= callNumber %>">Gọi <%= site.phone %></a><% } %>
              <a class="btn btn-ghost" href="/lien-he">Gửi tin nhắn</a>
            </span>
          </div>
          <div class="show-bars" aria-hidden="true">
            <% for (let n = 0; n <= showcase.length; n++) { %><i data-bar class="<%= n === 0 ? 'on' : '' %>"></i><% } %>
          </div>
          <button class="show-nav prev" type="button" data-prev aria-label="Trang trước">‹</button>
          <button class="show-nav next" type="button" data-next aria-label="Trang sau">›</button>
        </li>
      <% } else { %>
        <%- include('partials/card', { product: { ...product, badge: categories[product.category] }, big: i === 5 }) %>
      <% } %>
      <% if (i === 2) { %>
        <li class="mosaic-tile mosaic-accent" style="--photo: url('/images/mosaic-1.jpg')">
          <span class="eyebrow">Hàng mới về mỗi tuần</span>
          <a href="/san-pham"><b>Mẹ đẹp,<br>bé xinh.</b></a>
          <span class="mosaic-go" aria-hidden="true">Xem sản phẩm →</span>
        </li>
      <% } %>
      <% if (i === 4) { %>
        <li class="mosaic-tile mosaic-dark" style="--photo: url('/images/mosaic-2.jpg')">
          <span class="eyebrow">Còn nhiều mẫu khác</span>
          <a href="/san-pham"><b>Xem tất cả<br>sản phẩm →</b></a>
        </li>
      <% } %>
    <% }) %>
  </ul>
</section>

<section>
  <div class="section-head">
    <h2>Chọn theo danh mục</h2>
  </div>
  <ol class="category-list">
    <% Object.entries(categories).forEach(([key, label], i) => { %>
      <li>
        <a href="/san-pham?loai=<%= key %>"<% if (categoryImages[key]) { %> style="--photo: url('<%= categoryImages[key] %>')"<% } %>>
          <span class="idx">0<%= i + 1 %></span>
          <span class="name"><%= label %></span>
          <span class="art"><%- include('partials/shoe', { product: { category: key, name: '', outline: true, image_url: null } }) %></span>
          <span class="count"><%= counts[key] || 0 %> mẫu</span>
        </a>
      </li>
    <% }) %>
  </ol>
</section>

<section class="story">
  <%# Có ảnh story thì dùng làm nền (CSS phủ sẵn lớp tối để chữ trắng đọc được), không có thì giữ nền đen %>
  <div class="story-text"<% if (storyImage) { %> style="background-image: url('<%= storyImage %>')"<% } %>>
    <p class="eyebrow">Về <%= shopName %></p>
    <h2>Ít chi tiết hơn,<br>nhiều cá tính hơn.</h2>
    <p>Chúng tôi chọn từng đôi giày theo một tiêu chí: bỏ bớt những gì thừa để phần còn lại nổi bật.</p>
    <a class="btn" href="/gioi-thieu">Câu chuyện của chúng tôi</a>
  </div>
  <%# Có ảnh cửa hàng thì dùng ảnh làm nền, không có thì giữ hình vẽ trên nền xám %>
  <% if (storeImage) { %>
    <a class="story-art has-photo" href="/cua-hang" style="background-image: url('<%= storeImage %>')">
      <span class="eyebrow">Hệ thống cửa hàng</span>
      <span class="story-art-title">Thử giày tại cửa hàng</span>
      <span class="btn">Tìm cửa hàng gần bạn</span>
    </a>
  <% } else { %>
    <a class="story-art" href="/cua-hang">
      <%- include('partials/shoe', { product: { category: 'sneaker', name: '', color: '#111111', sole_color: 'var(--accent)', image_url: null } }) %>
      <span class="more">Thử giày tại cửa hàng</span>
    </a>
  <% } %>
</section>

<%- include('partials/footer') %>

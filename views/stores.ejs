<%- include('partials/header') %>

<section class="intro">
  <h1><%= title %></h1>
  <p>Ghé cửa hàng để thử giày trực tiếp cùng tư vấn viên.</p>
  <form class="store-search store-search-center" action="/cua-hang" method="get">
    <input type="search" name="q" value="<%= storeQuery %>" placeholder="Tỉnh / thành phố" aria-label="Tỉnh hoặc thành phố">
    <button type="submit" aria-label="Tìm cửa hàng">
      <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M13 13l5.5 5.5" stroke="currentColor" stroke-width="1.4"/></svg>
    </button>
  </form>
</section>

<% if (storeQuery) { %>
  <p class="result-note">Kết quả cho “<%= storeQuery %>” · <a href="/cua-hang">Xem tất cả cửa hàng</a></p>
<% } %>

<% if (stores.length === 0) { %>
  <p class="empty">Chưa có cửa hàng ở khu vực này. <a href="/lien-he">Liên hệ tư vấn viên</a></p>
<% } else { %>
  <ul class="store-list">
    <% stores.forEach((store, i) => { %>
      <li>
        <span class="idx">0<%= i + 1 %></span>
        <h2><%= store.name %></h2>
        <p><%= store.address %><br><%= store.city %></p>
        <% if (store.hours) { %><p class="muted"><%= store.hours %></p><% } %>
        <% if (store.phone) { %><a class="more" href="tel:<%= store.phone.replace(/\s/g, '') %>"><%= store.phone %></a><% } %>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include('partials/footer') %>

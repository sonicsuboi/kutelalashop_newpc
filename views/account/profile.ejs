<%- include('../partials/header') %>

<section class="intro">
  <h1><%= title %></h1>
  <p>Xin chào <%= customer.name %>.</p>
</section>

<section class="account<%= tab === 'don-hang' ? ' account-wide' : '' %>">
  <nav class="account-tabs" aria-label="Tài khoản">
    <a href="/tai-khoan" class="<%= tab === 'thong-tin' ? 'active' : '' %>">Tài khoản</a>
    <a href="/tai-khoan/don-hang" class="<%= tab === 'don-hang' ? 'active' : '' %>">Đơn hàng</a>
    <a href="/tai-khoan/mat-khau" class="<%= tab === 'mat-khau' ? 'active' : '' %>">Đổi mật khẩu</a>
  </nav>

  <% if (tab === 'thong-tin') { %>
    <% if (saved) { %><p class="account-ok" role="status">Đã lưu thông tin.</p><% } %>
    <form class="form" action="/tai-khoan" method="post" novalidate>
      <h2>Thông tin nhận hàng</h2>
      <label class="field">
        <span>Họ tên</span>
        <input type="text" name="name" value="<%= values.name || '' %>" maxlength="100" autocomplete="name" required>
        <% if (errors.name) { %><em><%= errors.name %></em><% } %>
      </label>
      <label class="field">
        <span>Số điện thoại (dùng để đăng nhập)</span>
        <input type="tel" value="<%= customer.phone %>" disabled>
      </label>
      <label class="field">
        <span>Địa chỉ nhận hàng</span>
        <textarea name="address" rows="2" maxlength="300" autocomplete="street-address"><%= values.address || '' %></textarea>
      </label>
      <button class="btn btn-dark" type="submit">Lưu thông tin</button>
    </form>
  <% } %>

  <% if (tab === 'don-hang') { %>
    <% if (!orders.length) { %>
      <p class="account-alt">Bạn chưa có đơn hàng nào đặt bằng tài khoản này. <a href="/san-pham">Xem sản phẩm mới</a></p>
      <p class="account-alt">Đơn đặt khi chưa đăng nhập: <a href="/tra-cuu-don">tra cứu bằng mã đơn</a>.</p>
    <% } else { %>
      <% for (const order of orders) { %>
        <%- include('../partials/order-card', { order, review: true }) %>
      <% } %>
    <% } %>
  <% } %>

  <% if (tab === 'mat-khau') { %>
    <% if (saved) { %><p class="account-ok" role="status">Đã đổi mật khẩu.</p><% } %>
    <form class="form" action="/tai-khoan/mat-khau" method="post" novalidate>
      <label class="field">
        <span>Mật khẩu hiện tại</span>
        <input type="password" name="current" maxlength="100" autocomplete="current-password" required>
        <% if (errors.current) { %><em><%= errors.current %></em><% } %>
      </label>
      <label class="field">
        <span>Mật khẩu mới (từ 6 ký tự)</span>
        <input type="password" name="password" maxlength="100" autocomplete="new-password" required>
        <% if (errors.password) { %><em><%= errors.password %></em><% } %>
      </label>
      <button class="btn btn-dark" type="submit">Đổi mật khẩu</button>
    </form>
  <% } %>

  <form class="account-logout" action="/tai-khoan/dang-xuat" method="post">
    <button class="text-btn" type="submit">Đăng xuất</button>
  </form>
</section>

<%- include('../partials/footer') %>

<%- include('partials/header') %>

<section class="intro">
  <h1><%= title %></h1>
  <p>Nhập mã đơn hàng (ví dụ KT00012) và số điện thoại đã dùng khi đặt.</p>
</section>

<section class="account">
  <form class="form" action="/tra-cuu-don" method="post">
    <% if (notFound) { %><p class="option-error" role="alert">Không tìm thấy đơn hàng với mã và số điện thoại này.</p><% } %>
    <label class="field">
      <span>Mã đơn hàng</span>
      <input type="text" name="code" value="<%= values.code %>" maxlength="12" autocomplete="off" required>
    </label>
    <label class="field">
      <span>Số điện thoại đặt hàng</span>
      <input type="tel" name="phone" value="<%= values.phone %>" maxlength="15" autocomplete="tel" required>
    </label>
    <button class="btn btn-dark" type="submit">Tra cứu</button>
  </form>

  <% if (order) { %>
    <h2>Kết quả</h2>
    <%- include('partials/order-card', { order }) %>
  <% } %>

  <p class="account-alt">Cần hỗ trợ về đơn hàng? <a href="/lien-he">Liên hệ shop</a></p>
</section>

<%- include('partials/footer') %>

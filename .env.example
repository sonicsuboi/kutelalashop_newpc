# Chép file này thành .env rồi điền giá trị. File .env không đưa lên git.

# Mật khẩu đăng nhập trang quản trị (/admin). Để trống thì trang quản trị bị tắt.
ADMIN_PASSWORD=
# Chuỗi ngẫu nhiên dùng để ký phiên đăng nhập quản trị
SESSION_SECRET=

# Thanh toán thẻ qua VNPay (thẻ ATM nội địa, Visa, Mastercard, JCB, QR).
# Lấy hai mã này khi đăng ký tài khoản merchant tại https://vnpay.vn (bản thử: https://sandbox.vnpayment.vn/devreg).
# Để trống thì giỏ hàng chỉ có "Thanh toán khi nhận hàng".
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Bản thử nghiệm. Khi chạy thật đổi thành https://pay.vnpay.vn/vpcpay.html
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Địa chỉ trang web mà khách truy cập, dùng làm địa chỉ quay về sau khi thanh toán
# BASE_URL=https://ten-mien-cua-ban.vn

# Chép file này thành .env rồi điền giá trị. File .env không đưa lên git.

# Database Postgres (Supabase, free). Lấy ở Project Settings > Database, dùng
# connection string "direct connection" (cổng 5432), không phải Transaction pooler.
DATABASE_URL=

# Supabase Storage (ảnh/video sản phẩm), lấy ở Project Settings > API.
# Dùng service_role key (không phải anon key) vì server cần quyền ghi.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Tên bucket Storage, tạo trước trong Supabase và đặt chế độ Public.
SUPABASE_STORAGE_BUCKET=product-media

# Mật khẩu đăng nhập trang quản trị (/admin). Để trống thì trang quản trị bị tắt.
ADMIN_PASSWORD=
# Chuỗi ngẫu nhiên dùng để ký phiên đăng nhập quản trị
SESSION_SECRET=

# Thanh toán thẻ qua VNPay (thẻ ATM nội địa, Visa, Mastercard, JCB, QR).
# Lấy hai mã này khi đăng ký tài khoản merchant tại https://vnpay.vn (bản thử: https://sandbox.vnpayment.vn/devreg).
# Để trống thì giỏ hàng chỉ có "Thanh toán khi nhận hàng".
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Bản thử nghiệm. Khi chạy thật đổi thành https://pay.vnpay.vn/vpcpay.html
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Địa chỉ trang web mà khách truy cập, dùng làm địa chỉ quay về sau khi thanh toán
# BASE_URL=https://ten-mien-cua-ban.vn

# Báo đơn hàng / tin nhắn mới cho shop qua email, dùng dịch vụ Resend (https://resend.com, miễn phí).
# Để trống thì không gửi email. NOTIFY_EMAIL để trống thì gửi tới email của shop ở trang quản trị.
RESEND_API_KEY=
# NOTIFY_EMAIL=
